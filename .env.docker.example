# App database provider
DATABASE_PROVIDER=postgres

# PostgREST endpoint used by Next.js server routes
POSTGREST_URL=http://postgrest:3000
POSTGREST_API_KEY=

# Admin dashboard
ADMIN_DASHBOARD_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me
ADMIN_COOKIE_SECURE=false

# GitHub trigger (optional)
GITHUB_ACTIONS_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_WORKFLOW_ID=weekly-predictions.yml
GITHUB_WORKFLOW_REF=main

# Postgres container settings
POSTGRES_USER=proxima
POSTGRES_PASSWORD=proxima_password
POSTGRES_DB=proxima_ai
POSTGRES_DATA_DIR=/home/anmarrahman/docker/proxima-football-ai/proxima_postgres_data
