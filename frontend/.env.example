# Public client URL/key (optional if only using server routes)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only key used by Next.js API routes
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Admin dashboard auth
ADMIN_DASHBOARD_PASSWORD=<strong-admin-password>
ADMIN_SESSION_SECRET=<long-random-secret>

# GitHub Actions workflow dispatch (manual trigger from /admin)
GITHUB_ACTIONS_TOKEN=<github-pat-with-actions-write>
GITHUB_REPO_OWNER=<github-owner>
GITHUB_REPO_NAME=<github-repo>
GITHUB_WORKFLOW_ID=tier-a-predictions.yml
GITHUB_WORKFLOW_REF=main
